{
  "name": "take-me-out",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "bin": {
    "install": "./scripts/install.js"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": ["react-native-google-mobile-ads"]
      }
    }
  },
  "scripts": {
    "postinstall": "chmod +x node_modules/.bin/expo || true",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/app.smoke.test.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "expo": "~54.0.34",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.5",
    "expo-router": "~6.0.23",
    "expo-sqlite": "~16.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-google-mobile-ads": "^17.0.0",
    "react-native-maps": "1.20.1",
    "react-native-paper": "^5.12.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.9.2",
    "vitest": "^2.1.8"
  }
}
